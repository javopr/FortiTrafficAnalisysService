@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Access Denied</h4>
                </div>
                <div class="card-body text-center">
                    <i class="bi bi-shield-exclamation" style="font-size: 5rem; color: #dc3545;"></i>
                    <h2 class="mt-3">You don't have permission to access this resource</h2>
                    <p class="lead mt-3">
                        Your account (@User.Identity?.Name) is not authorized to access the FortiGate Traffic Analysis Service.
                    </p>
                    <hr class="my-4">
                    <p>
                        If you believe you should have access, please contact your system administrator.
                    </p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">
                        <i class="bi bi-house"></i> Go to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
