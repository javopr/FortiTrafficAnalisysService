@model FortiTrafficAnalysis.WebGui.Models.EditTrafficAnalysisViewModel

@{
    ViewData["Title"] = "Edit Ticket - " + Model.TicketNumber;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Traffic Analysis Ticket</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.TrafficAnalysisID" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TrafficAnalysisID" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Read-Only Information -->
                        <div class="card mb-4 bg-light">
                            <div class="card-body">
                                <h6 class="card-title"><i class="bi bi-info-circle"></i> Ticket Information (Read-Only)</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-2"><strong>Ticket Number:</strong> <code class="text-primary">@Model.TicketNumber</code></p>
                                        <p class="mb-2"><strong>Customer:</strong> @Model.CustomerName</p>
                                        <p class="mb-2"><strong>Service:</strong> <code>@Model.ServiceJobID</code></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="mb-2"><strong>FortiGate:</strong> @Model.FortiGateHostname</p>
                                        <p class="mb-2"><strong>Status:</strong> <span class="badge bg-info">@Model.Status</span></p>
                                        <p class="mb-2"><strong>Created By:</strong> @Model.CreatedByUPN</p>
                                        <p class="mb-0"><strong>Created Date:</strong> @(Model.CreatedDate?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? "N/A")</p>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- Editable Fields -->
                        <h6 class="mb-3"><i class="bi bi-pencil"></i> Editable Fields</h6>

                        <div class="mb-3">
                            <label asp-for="Summary" class="form-label"></label>
                            <input asp-for="Summary" class="form-control" placeholder="Brief summary of the analysis" maxlength="200" autofocus />
                            <span asp-validation-for="Summary" class="text-danger"></span>
                            <small class="form-text text-muted">Maximum 200 characters</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Detailed description of what you're analyzing..." maxlength="2000"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                            <small class="form-text text-muted">Maximum 2000 characters (Optional)</small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Details" asp-route-id="@Model.TrafficAnalysisID" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



