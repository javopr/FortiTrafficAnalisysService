@model IEnumerable<FortiTrafficAnalysis.Domain.Entities.TrafficAnalysis>

@{
    ViewData["Title"] = "Traffic Analysis Tickets";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-clipboard-data"></i> Traffic Analysis</h2>
            <p class="text-muted">Analyze FortiGate traffic logs and generate policy recommendations</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> New Analysis Ticket
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Ticket #</th>
                                <th>Summary</th>
                                <th>Customer</th>
                                <th>FortiGate</th>
                                <th>Status</th>
                                <th class="text-center">Logs</th>
                                <th class="text-center">Recommendations</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong><code>@item.TicketNumber</code></strong></td>
                                    <td>
                                        <strong>@item.Summary</strong>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <br><small class="text-muted">@(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</small>
                                        }
                                    </td>
                                    <td>@(item.FortiGate?.FTAService?.Customer?.CustomerName ?? "N/A")</td>
                                    <td><code>@item.FortiGate?.FGHostname</code></td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case "Open":
                                                <span class="badge bg-success">@item.Status</span>
                                                break;
                                            case "In Progress":
                                                <span class="badge bg-info">@item.Status</span>
                                                break;
                                            case "Closed":
                                                <span class="badge bg-secondary">@item.Status</span>
                                                break;
                                            default:
                                                <span class="badge bg-primary">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@item.TrafficLogs.Count</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning">@item.Recommendations.Count</span>
                                    </td>
                                    <td>
                                        <small>
                                            @item.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")
                                            <br>by <code>@item.CreatedByUPN</code>
                                        </small>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.TrafficAnalysisID" 
                                               class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Admins"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.TrafficAnalysisID" 
                                                   class="btn btn-sm btn-outline-danger" title="Delete"
                                                   onclick="return confirm('Are you sure you want to delete this ticket and all its logs?');">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No traffic analysis tickets found. Click "New Analysis Ticket" to get started.</p>
                </div>
            }
        </div>
    </div>
</div>
