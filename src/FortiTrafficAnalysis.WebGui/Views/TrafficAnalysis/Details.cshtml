@model FortiTrafficAnalysis.Domain.Entities.TrafficAnalysis

@{
    ViewData["Title"] = "Traffic Analysis - " + Model.Summary;
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-3">
        <div class="col-md-8">
            <h2><i class="bi bi-clipboard-data"></i> @Model.Summary</h2>
            <p class="text-muted">@Model.Description</p>
        </div>
        <div class="col-md-4 text-end">
            @if (User.IsInRole("Admins") || Model.CreatedByUPN == User.Identity?.Name)
            {
                <a asp-action="Edit" asp-route-id="@Model.TrafficAnalysisID" class="btn btn-warning me-2">
                    <i class="bi bi-pencil-square"></i> Edit Ticket
                </a>
            }
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Ticket Info Card -->
    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Ticket Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Ticket Number:</dt>
                        <dd class="col-sm-9"><h4><code class="text-primary">@Model.TicketNumber</code></h4></dd>

                        <dt class="col-sm-3">Ticket ID:</dt>
                        <dd class="col-sm-9"><small><code>@Model.TrafficAnalysisID</code></small></dd>

                        <dt class="col-sm-3">Customer:</dt>
                        <dd class="col-sm-9">@(Model.FortiGate?.FTAService?.Customer?.CustomerName ?? "N/A")</dd>

                        <dt class="col-sm-3">Service:</dt>
                        <dd class="col-sm-9"><code>@(Model.FortiGate?.FTAService?.JobID ?? "N/A")</code></dd>

                        <dt class="col-sm-3">FortiGate:</dt>
                        <dd class="col-sm-9">
                            <strong>@Model.FortiGate?.FGHostname</strong>
                            <br><small class="text-muted">@Model.FortiGate?.FGHost</small>
                        </dd>

                        <dt class="col-sm-3">Created By:</dt>
                        <dd class="col-sm-9">@Model.CreatedByUPN</dd>

                        <dt class="col-sm-3">Created Date:</dt>
                        <dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("MMMM dd, yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Status:</dt>
                        <dd class="col-sm-9">
                            @switch (Model.Status)
                            {
                                case "Open":
                                    <span class="badge bg-success">@Model.Status</span>
                                    break;
                                case "In Progress":
                                    <span class="badge bg-info">@Model.Status</span>
                                    break;
                                case "Closed":
                                    <span class="badge bg-secondary">@Model.Status</span>
                                    break;
                                default:
                                    <span class="badge bg-primary">@Model.Status</span>
                                    break;
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span><i class="bi bi-list-ul"></i> Traffic Logs:</span>
                        <span class="badge bg-info fs-6">@Model.TrafficLogs.Count</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-lightbulb"></i> Recommendations:</span>
                        <span class="badge bg-warning fs-6">@Model.Recommendations.Count</span>
                    </div>
                </div>
            </div>

            @if (Model.Status != "Closed")
            {
                <div class="card mt-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Actions</h6>
                    </div>
                    <div class="card-body">
                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@Model.TrafficAnalysisID" />
                            <div class="d-grid gap-2">
                                @if (Model.Status == "Open")
                                {
                                    <button type="submit" name="status" value="In Progress" class="btn btn-sm btn-info">
                                        Mark as In Progress
                                    </button>
                                }
                                @if (Model.Status != "Closed")
                                {
                                    <button type="submit" name="status" value="Closed" class="btn btn-sm btn-secondary">
                                        Close Ticket
                                    </button>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Log Ingestion Section -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-upload"></i> Log Ingestion</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">Import traffic logs from FortiGate or FortiAnalyzer to begin analysis.</p>
            
            <div class="row">
                <!-- FortiGate Log File Upload (IMPLEMENTED) -->
                <div class="col-lg-6 mb-3">
                    <div class="card h-100">
                        <div class="card-header bg-success text-white">
                            <h6 class="mb-0"><i class="bi bi-file-earmark-arrow-up"></i> Upload FortiGate Log File</h6>
                        </div>
                        <div class="card-body">
                            <form asp-action="UploadLogFile" asp-route-id="@Model.TrafficAnalysisID" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                
                                <div class="mb-3">
                                    <label for="logFile" class="form-label">Select Log File</label>
                                    <input type="file" class="form-control" id="logFile" name="logFile" accept=".log,.txt" required>
                                    <small class="form-text text-muted">
                                        Accepted formats: .log, .txt (Max 50MB)
                                    </small>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-upload"></i> Upload & Parse Logs
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Other Ingestion Methods (PLACEHOLDER) -->
                <div class="col-lg-6 mb-3">
                    <div class="card h-100">
                        <div class="card-header bg-secondary text-white">
                            <h6 class="mb-0"><i class="bi bi-cloud-arrow-down"></i> Other Ingestion Methods</h6>
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                <button class="list-group-item list-group-item-action disabled" disabled>
                                    <i class="bi bi-hdd-network"></i> Fetch from FortiGate via REST API
                                    <span class="badge bg-warning float-end">Coming Soon</span>
                                </button>
                                <button class="list-group-item list-group-item-action disabled" disabled>
                                    <i class="bi bi-server"></i> Fetch from FortiAnalyzer via REST API
                                    <span class="badge bg-warning float-end">Coming Soon</span>
                                </button>
                                <button class="list-group-item list-group-item-action disabled" disabled>
                                    <i class="bi bi-file-earmark-text"></i> Upload FortiAnalyzer Log File
                                    <span class="badge bg-warning float-end">Coming Soon</span>
                                </button>
                            </div>
                            <small class="text-muted d-block mt-2">
                                <i class="bi bi-info-circle"></i> Additional ingestion methods will be implemented in future releases.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Traffic Logs Table Section -->
    <div class="card mb-4" id="logsSection">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-table"></i> Traffic Logs (<span id="logCount">@Model.TrafficLogs.Count</span>)</h5>
            <div>
                <a href="#recommendationsSection" class="btn btn-sm btn-info me-2">
                    <i class="bi bi-arrow-down-circle"></i> Jump to Recommendations
                </a>
                <button class="btn btn-sm btn-light" id="refreshLogsBtn">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
                <button class="btn btn-sm btn-warning" id="analyzeSelectedBtn" disabled>
                    <i class="bi bi-lightbulb"></i> Analyze Selected (<span id="selectedCount">0</span>)
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (Model.TrafficLogs.Any())
            {
                <!-- Basic Filter Controls -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <input type="text" id="searchBox" class="form-control form-control-sm" placeholder="Quick Search...">
                    </div>
                    <div class="col-md-2">
                        <select id="filterAction" class="form-select form-select-sm">
                            <option value="">All Actions</option>
                            <option value="accept">Accept</option>
                            <option value="deny">Deny</option>
                            <option value="client-rst">Client-RST</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="text" id="filterSrcIp" class="form-control form-control-sm" placeholder="Source IP">
                    </div>
                    <div class="col-md-2">
                        <input type="text" id="filterDstIp" class="form-control form-control-sm" placeholder="Dest IP">
                    </div>
                    <div class="col-md-2">
                        <select id="filterProto" class="form-select form-select-sm">
                            <option value="">All Protocols</option>
                            <option value="6">TCP (6)</option>
                            <option value="17">UDP (17)</option>
                            <option value="1">ICMP (1)</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-sm btn-secondary w-100" id="clearFiltersBtn">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>

                <!-- Advanced Filters (Collapsible) -->
                <div class="mb-3">
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters">
                        <i class="bi bi-funnel"></i> Advanced Filters
                    </button>
                </div>
                
                <div class="collapse" id="advancedFilters">
                    <div class="card card-body mb-3 bg-light">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label small">Source Port</label>
                                <input type="text" id="filterSrcPort" class="form-control form-control-sm" placeholder="e.g. 443">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Dest Port</label>
                                <input type="text" id="filterDstPort" class="form-control form-control-sm" placeholder="e.g. 80">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Source Interface</label>
                                <input type="text" id="filterSrcIntf" class="form-control form-control-sm" placeholder="e.g. port1">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Dest Interface</label>
                                <input type="text" id="filterDstIntf" class="form-control form-control-sm" placeholder="e.g. port2">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Service</label>
                                <input type="text" id="filterService" class="form-control form-control-sm" placeholder="e.g. HTTPS">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Policy ID</label>
                                <input type="text" id="filterPolicyId" class="form-control form-control-sm" placeholder="e.g. 5">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Policy Name</label>
                                <input type="text" id="filterPolicyName" class="form-control form-control-sm" placeholder="Policy name">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Log ID</label>
                                <input type="text" id="filterLogId" class="form-control form-control-sm" placeholder="Log ID">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Session ID</label>
                                <input type="text" id="filterSessionId" class="form-control form-control-sm" placeholder="Session ID">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Date From</label>
                                <input type="date" id="filterDateFrom" class="form-control form-control-sm">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Date To</label>
                                <input type="date" id="filterDateTo" class="form-control form-control-sm">
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button class="btn btn-sm btn-primary w-100" id="applyAdvancedFiltersBtn">
                                    <i class="bi bi-check-circle"></i> Apply Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Column Visibility Controls -->
                <div class="mb-2">
                    <small class="text-muted">
                        <i class="bi bi-eye"></i> Show/Hide Columns:
                        <div class="btn-group btn-group-sm" role="group" id="columnToggle">
                            <input type="checkbox" class="btn-check" id="col-service" checked autocomplete="off">
                            <label class="btn btn-outline-secondary" for="col-service">Service</label>
                            
                            <input type="checkbox" class="btn-check" id="col-policyname" checked autocomplete="off">
                            <label class="btn btn-outline-secondary" for="col-policyname">Policy Name</label>
                            
                            <input type="checkbox" class="btn-check" id="col-bytes" autocomplete="off">
                            <label class="btn btn-outline-secondary" for="col-bytes">Bytes</label>
                            
                            <input type="checkbox" class="btn-check" id="col-duration" autocomplete="off">
                            <label class="btn btn-outline-secondary" for="col-duration">Duration</label>
                        </div>
                    </small>
                </div>

                <!-- Logs Table -->
                <div class="table-responsive">
                    <table class="table table-sm table-hover" id="logsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;">
                                    <input type="checkbox" id="selectAll">
                                </th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Log ID</th>
                                <th>Src IP</th>
                                <th>Src Int</th>
                                <th>Src Port</th>
                                <th>Dst IP</th>
                                <th>Dst Int</th>
                                <th>Dst Port</th>
                                <th>Proto</th>
                                <th>Policy ID</th>
                                <th>Action</th>
                                <th class="col-service">Service</th>
                                <th class="col-policyname">Policy Name</th>
                                <th class="col-bytes">Sent</th>
                                <th class="col-bytes">Rcvd</th>
                                <th class="col-duration">Duration</th>
                            </tr>
                        </thead>
                        <tbody id="logsTableBody">
                            <tr>
                                <td colspan="18" class="text-center">
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    Loading logs...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div id="noLogsMessage" class="text-center py-3 d-none">
                    <i class="bi bi-info-circle"></i> No logs match the current filters.
                </div>

                <!-- Pagination Controls -->
                <div id="paginationControls" class="mt-3"></div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No traffic logs ingested yet. Use the ingestion tools above to import logs.</p>
                </div>
            }
        </div>
    </div>

    <!-- Recommendations Section -->
    <div class="card" id="recommendationsSection">
        <div class="card-header bg-warning d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-lightbulb"></i> Policy Recommendations (@Model.Recommendations.Count)</h5>
            <a href="#logsSection" class="btn btn-sm btn-secondary">
                <i class="bi bi-arrow-up-circle"></i> Back to Logs
            </a>
        </div>
        <div class="card-body">
            @if (Model.Recommendations.Any())
            {
                <div class="list-group">
                    @foreach (var recommendation in Model.Recommendations.OrderByDescending(r => r.CreatedDate))
                    {
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@recommendation.Title</h6>
                                <small class="text-muted">@recommendation.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</small>
                            </div>
                            <p class="mb-1">@recommendation.RecommendationText</p>
                            <small class="text-muted">Created by: @recommendation.CreatedByUPN</small>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-lightbulb-off" style="font-size: 2rem; color: #ccc;"></i>
                    <p class="text-muted mt-2">No recommendations yet. Analyze traffic logs to generate policy recommendations.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    var ticketId = '@Model.TrafficAnalysisID';
    var allLogs = [];
    var selectedLogIds = [];
    var currentPage = 1;
    var pageSize = 100;
    var totalPages = 1;
    var totalCount = 0;

    console.log('Ticket ID:', ticketId);
    console.log('Ticket ID type:', typeof ticketId);

    $(document).ready(function() {
        // Load logs on page load
        loadLogs();

            // Refresh button
            $('#refreshLogsBtn').click(function() {
                loadLogs();
            });

            // Filter controls - reset to page 1 when filtering
            $('#searchBox, #filterAction, #filterSrcIp, #filterDstIp, #filterProto').on('input change', function() {
                currentPage = 1;
                loadLogs();
            });

            // Clear filters
            $('#clearFiltersBtn').click(function() {
                $('#searchBox').val('');
                $('#filterAction').val('');
                $('#filterSrcIp').val('');
                $('#filterDstIp').val('');
                $('#filterProto').val('');
                
                // Clear advanced filters
                $('#filterSrcPort').val('');
                $('#filterDstPort').val('');
                $('#filterSrcIntf').val('');
                $('#filterDstIntf').val('');
                $('#filterService').val('');
                $('#filterPolicyId').val('');
                $('#filterPolicyName').val('');
                $('#filterLogId').val('');
                $('#filterSessionId').val('');
                $('#filterDateFrom').val('');
                $('#filterDateTo').val('');
                
                currentPage = 1; // Reset to first page
                loadLogs();
            });

            // Apply advanced filters button
            $('#applyAdvancedFiltersBtn').click(function() {
                currentPage = 1; // Reset to first page
                loadLogs();
            });

            // Also trigger on Enter key in advanced filter inputs
            $('#advancedFilters input').on('keypress', function(e) {
                if (e.which === 13) {
                    currentPage = 1; // Reset to first page
                    loadLogs();
                }
            });

            // Column visibility toggles
            $('#col-service, #col-policyname, #col-bytes, #col-duration').change(function() {
                var column = $(this).attr('id');
                var isVisible = $(this).is(':checked');
                $('.' + column).toggle(isVisible);
            });

            // Initialize column visibility
            $('.col-bytes, .col-duration').hide();

            // Select all checkbox
            $('#selectAll').change(function() {
                var isChecked = $(this).is(':checked');
                $('.log-checkbox:visible').prop('checked', isChecked).trigger('change');
            });

            // Analyze selected button
            $('#analyzeSelectedBtn').click(function() {
                if (selectedLogIds.length === 0) {
                    alert('Please select at least one log entry');
                    return;
                }
                analyzeSelectedLogs();
            });
        });

        function loadLogs() {
            console.log('loadLogs() called - Page:', currentPage, 'PageSize:', pageSize);
            
            // Build data object with only non-empty values
            var requestData = { 
                id: ticketId,
                page: currentPage,
                pageSize: pageSize
            };
            
            var search = $('#searchBox').val();
            var action = $('#filterAction').val();
            var srcIp = $('#filterSrcIp').val();
            var dstIp = $('#filterDstIp').val();
            var proto = $('#filterProto').val();
            
            // Advanced filters
            var srcPort = $('#filterSrcPort').val();
            var dstPort = $('#filterDstPort').val();
            var srcIntf = $('#filterSrcIntf').val();
            var dstIntf = $('#filterDstIntf').val();
            var service = $('#filterService').val();
            var policyId = $('#filterPolicyId').val();
            var policyName = $('#filterPolicyName').val();
            var logId = $('#filterLogId').val();
            var sessionId = $('#filterSessionId').val();
            var dateFrom = $('#filterDateFrom').val();
            var dateTo = $('#filterDateTo').val();
            
            if (search) requestData.search = search;
            if (action) requestData.filterAction = action;
            if (srcIp) requestData.srcIp = srcIp;
            if (dstIp) requestData.dstIp = dstIp;
            if (proto) requestData.proto = proto;
            
            if (srcPort) requestData.srcPort = srcPort;
            if (dstPort) requestData.dstPort = dstPort;
            if (srcIntf) requestData.srcIntf = srcIntf;
            if (dstIntf) requestData.dstIntf = dstIntf;
            if (service) requestData.service = service;
            if (policyId) requestData.policyId = policyId;
            if (policyName) requestData.policyName = policyName;
            if (logId) requestData.logId = logId;
            if (sessionId) requestData.sessionId = sessionId;
            if (dateFrom) requestData.dateFrom = dateFrom;
            if (dateTo) requestData.dateTo = dateTo;
            
            console.log('Request data:', requestData);
            
            // Show loading indicator
            $('#logsTableBody').html('<tr><td colspan="18" class="text-center"><div class="spinner-border spinner-border-sm"></div> Loading page ' + currentPage + '...</td></tr>');
            
            $.ajax({
                url: '@Url.Action("GetLogs", "TrafficAnalysis")',
                type: 'GET',
                data: requestData,
                success: function(response) {
                    console.log('AJAX Success!');
                    console.log('Logs loaded:', response.logs.length);
                    console.log('Pagination:', response.pagination);
                    
                    allLogs = response.logs;
                    totalCount = response.pagination.totalCount;
                    totalPages = response.pagination.totalPages;
                    
                    renderLogs(response.logs);
                    renderPagination(response.pagination);
                    $('#logCount').text(response.pagination.filteredCount + ' of ' + totalCount);
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error!');
                    console.error('Status:', status);
                    console.error('Error:', error);
                    $('#logsTableBody').html('<tr><td colspan="18" class="text-center text-danger">Error loading logs: ' + error + '</td></tr>');
                }
            });
        }

        function renderPagination(pagination) {
            if (pagination.totalPages <= 1) {
                $('#paginationControls').html('');
                return;
            }

            var html = '<nav><ul class="pagination pagination-sm justify-content-center mb-0">';
            
            // Previous button
            html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">';
            html += '<a class="page-link" href="#" data-page="' + (currentPage - 1) + '">Previous</a></li>';
            
            // Page numbers (show max 5 pages)
            var startPage = Math.max(1, currentPage - 2);
            var endPage = Math.min(pagination.totalPages, currentPage + 2);
            
            if (startPage > 1) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>';
                if (startPage > 2) html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
            }
            
            for (var i = startPage; i <= endPage; i++) {
                html += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '">';
                html += '<a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
            }
            
            if (endPage < pagination.totalPages) {
                if (endPage < pagination.totalPages - 1) html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + pagination.totalPages + '">' + pagination.totalPages + '</a></li>';
            }
            
            // Next button
            html += '<li class="page-item ' + (currentPage === pagination.totalPages ? 'disabled' : '') + '">';
            html += '<a class="page-link" href="#" data-page="' + (currentPage + 1) + '">Next</a></li>';
            
            html += '</ul></nav>';
            html += '<small class="text-muted d-block text-center mt-2">Showing page ' + currentPage + ' of ' + pagination.totalPages + ' (' + pagination.filteredCount + ' total logs)</small>';
            
            $('#paginationControls').html(html);
            
            // Attach click handlers
            $('#paginationControls a.page-link').click(function(e) {
                e.preventDefault();
                var page = parseInt($(this).data('page'));
                if (page >= 1 && page <= totalPages) {
                    currentPage = page;
                    loadLogs();
                    $('html, body').animate({ scrollTop: $('#logsSection').offset().top - 100 }, 300);
                }
            });
        }

        function renderPagination(pagination) {
            if (pagination.totalPages <= 1) {
                $('#paginationControls').html('');
                return;
            }

            var html = '<nav><ul class="pagination pagination-sm justify-content-center mb-0">';
            
            // Previous button
            html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">';
            html += '<a class="page-link" href="#" data-page="' + (currentPage - 1) + '">Previous</a></li>';
            
            // Page numbers (show max 5 pages)
            var startPage = Math.max(1, currentPage - 2);
            var endPage = Math.min(pagination.totalPages, currentPage + 2);
            
            if (startPage > 1) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>';
                if (startPage > 2) html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
            }
            
            for (var i = startPage; i <= endPage; i++) {
                html += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '">';
                html += '<a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
            }
            
            if (endPage < pagination.totalPages) {
                if (endPage < pagination.totalPages - 1) html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + pagination.totalPages + '">' + pagination.totalPages + '</a></li>';
            }
            
            // Next button
            html += '<li class="page-item ' + (currentPage === pagination.totalPages ? 'disabled' : '') + '">';
            html += '<a class="page-link" href="#" data-page="' + (currentPage + 1) + '">Next</a></li>';
            
            html += '</ul></nav>';
            html += '<small class="text-muted d-block text-center mt-2">Showing page ' + currentPage + ' of ' + pagination.totalPages + ' (' + pagination.filteredCount + ' total logs)</small>';
            
            $('#paginationControls').html(html);
            
            // Attach click handlers
            $('#paginationControls a.page-link').click(function(e) {
                e.preventDefault();
                var page = parseInt($(this).data('page'));
                if (page >= 1 && page <= totalPages) {
                    currentPage = page;
                    loadLogs();
                    $('html, body').animate({ scrollTop: $('#logsSection').offset().top - 100 }, 300);
                }
            });
        }

        function renderLogs(logs) {
            if (logs.length === 0) {
                $('#logsTableBody').html('<tr><td colspan="18" class="text-center">No logs found</td></tr>');
                $('#noLogsMessage').removeClass('d-none');
                return;
            }

            $('#noLogsMessage').addClass('d-none');
            var html = '';

            logs.forEach(function(log) {
                var isSelected = selectedLogIds.includes(log.trafficLogID);
                var rowClass = isSelected ? 'table-primary' : '';
                
                html += '<tr class="' + rowClass + '" data-log-id="' + log.trafficLogID + '">';
                html += '<td><input type="checkbox" class="log-checkbox" data-log-id="' + log.trafficLogID + '" ' + (isSelected ? 'checked' : '') + '></td>';
                html += '<td>' + formatDate(log.logDate) + '</td>';
                html += '<td>' + (log.logTime || '') + '</td>';
                html += '<td><small>' + (log.logId || '') + '</small></td>';
                html += '<td><code>' + (log.srcIP || '') + '</code></td>';
                html += '<td><small>' + (log.srcInt || '') + '</small></td>';
                html += '<td>' + (log.srcPort || '') + '</td>';
                html += '<td><code>' + (log.dstIP || '') + '</code></td>';
                html += '<td><small>' + (log.dstInt || '') + '</small></td>';
                html += '<td>' + (log.dstPort || '') + '</td>';
                html += '<td>' + (log.proto || '') + '</td>';
                html += '<td>' + (log.policyId || '') + '</td>';
                html += '<td>' + getActionBadge(log.action) + '</td>';
                html += '<td class="col-service">' + (log.service || '') + '</td>';
                html += '<td class="col-policyname"><small>' + (log.policyName || '') + '</small></td>';
                html += '<td class="col-bytes">' + formatBytes(log.sentByte) + '</td>';
                html += '<td class="col-bytes">' + formatBytes(log.rcvdByte) + '</td>';
                html += '<td class="col-duration">' + (log.duration || '') + '</td>';
                html += '</tr>';
            });

            $('#logsTableBody').html(html);

            // Reapply column visibility
            if (!$('#col-service').is(':checked')) $('.col-service').hide();
            if (!$('#col-policyname').is(':checked')) $('.col-policyname').hide();
            if (!$('#col-bytes').is(':checked')) $('.col-bytes').hide();
            if (!$('#col-duration').is(':checked')) $('.col-duration').hide();

            // Attach checkbox event handlers
            $('.log-checkbox').change(function() {
                var logId = $(this).data('log-id');
                var isChecked = $(this).is(':checked');
                var row = $(this).closest('tr');

                if (isChecked) {
                    if (!selectedLogIds.includes(logId)) {
                        selectedLogIds.push(logId);
                        console.log('Added log to selection:', logId, '| Total selected:', selectedLogIds.length);
                    }
                    row.addClass('table-primary');
                } else {
                    selectedLogIds = selectedLogIds.filter(id => id !== logId);
                    console.log('Removed log from selection:', logId, '| Total selected:', selectedLogIds.length);
                    row.removeClass('table-primary');
                }

                updateSelectedCount();
                updateSelectAllCheckbox();
            });
            
            updateSelectAllCheckbox();
        }

        function updateSelectAllCheckbox() {
            var visibleCheckboxes = $('.log-checkbox:visible');
            var checkedCheckboxes = $('.log-checkbox:visible:checked');
            
            if (visibleCheckboxes.length === 0) {
                $('#selectAll').prop('checked', false).prop('indeterminate', false);
            } else if (checkedCheckboxes.length === 0) {
                $('#selectAll').prop('checked', false).prop('indeterminate', false);
            } else if (checkedCheckboxes.length === visibleCheckboxes.length) {
                $('#selectAll').prop('checked', true).prop('indeterminate', false);
            } else {
                $('#selectAll').prop('checked', false).prop('indeterminate', true);
            }
        }

        function updateSelectedCount() {
            $('#selectedCount').text(selectedLogIds.length);
            $('#analyzeSelectedBtn').prop('disabled', selectedLogIds.length === 0);
        }

        function getActionBadge(action) {
            if (!action) return '';
            
            var badgeClass = 'bg-secondary';
            if (action === 'accept') badgeClass = 'bg-success';
            else if (action === 'deny') badgeClass = 'bg-danger';
            else if (action.includes('rst')) badgeClass = 'bg-warning';

            return '<span class="badge ' + badgeClass + '">' + action + '</span>';
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            return date.toLocaleDateString();
        }

        function formatBytes(bytes) {
            if (!bytes || bytes === 0) return '0';
            var k = 1024;
            var sizes = ['B', 'KB', 'MB', 'GB'];
            var i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        function analyzeSelectedLogs() {
            if (selectedLogIds.length === 0) {
                alert('Please select at least one log entry');
                return;
            }

            if (!confirm(`Analyze ${selectedLogIds.length} selected log(s) and generate policy recommendations?`)) {
                return;
            }

            $('#analyzeSelectedBtn').prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> Analyzing...');

            $.ajax({
                url: '@Url.Action("AnalyzeSelected", "TrafficAnalysis")' + '?id=' + ticketId,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(selectedLogIds),
                success: function(response) {
                    console.log('Analysis response:', response);
                    
                    if (response.success) {
                        alert(`? Success!\n\n${response.message}\n\nThe page will reload to show the recommendations.`);
                        window.location.reload();
                    } else {
                        alert(`? Error: ${response.message}`);
                        $('#analyzeSelectedBtn').prop('disabled', false).html('<i class="bi bi-lightbulb"></i> Analyze Selected (<span id="selectedCount">' + selectedLogIds.length + '</span>)');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Analysis error:', error);
                    console.error('Response:', xhr.responseText);
                    alert(`? Error analyzing logs: ${error}\n\nCheck console for details.`);
                    $('#analyzeSelectedBtn').prop('disabled', false).html('<i class="bi bi-lightbulb"></i> Analyze Selected (<span id="selectedCount">' + selectedLogIds.length + '</span>)');
                }
            });
        }
    </script>
}

