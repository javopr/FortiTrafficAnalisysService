@model IEnumerable<FortiTrafficAnalysis.WebGui.Models.FortiGateViewModel>

@{
    ViewData["Title"] = "FortiGate Devices Management";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-shield-check"></i> FortiGate Devices</h2>
            <p class="text-muted">Manage FortiGate firewall devices and credentials</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Device
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>FG Name</th>
                                <th>IP/Host</th>
                                <th>Serial Number</th>
                                <th>API Key</th>
                                <th>Customer</th>
                                <th>Service</th>
                                <th>Status</th>
                                <th class="text-center">Logs</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var apiKeyDisplay = item.FGapiKey?.Length > 4 
                                    ? $"{item.FGapiKey.Substring(0, 2)}••••••{item.FGapiKey.Substring(item.FGapiKey.Length - 2)}" 
                                    : "••••••••";
                                <tr>
                                    <td><strong>@item.FGHostname</strong></td>
                                    <td><code>@item.FGHost</code></td>
                                    <td><small><code>@item.FGSerial</code></small></td>
                                    <td><code class="text-muted">@apiKeyDisplay</code></td>
                                    <td>@item.CustomerName</td>
                                    <td><code>@item.ServiceJobID</code></td>
                                    <td>
                                        @switch (item.FGStatus)
                                        {
                                            case "Active":
                                                <span class="badge bg-success">@item.FGStatus</span>
                                                break;
                                            case "Inactive":
                                                <span class="badge bg-secondary">@item.FGStatus</span>
                                                break;
                                            case "Maintenance":
                                                <span class="badge bg-warning">@item.FGStatus</span>
                                                break;
                                            case "Offline":
                                                <span class="badge bg-danger">@item.FGStatus</span>
                                                break;
                                            default:
                                                <span class="badge bg-info">@item.FGStatus</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@item.LogCount</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.FGID" 
                                               class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.FGID" 
                                               class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.FGID" 
                                               class="btn btn-sm btn-outline-danger" title="Delete"
                                               onclick="return confirm('Are you sure you want to delete device @item.FGHostname?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No FortiGate devices found. Click "Add New Device" to get started.</p>
                </div>
            }
        </div>
    </div>
</div>
