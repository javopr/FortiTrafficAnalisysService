@model IEnumerable<FortiTrafficAnalysis.WebGui.Models.FTAServiceViewModel>

@{
    ViewData["Title"] = "FTA Services Management";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-briefcase"></i> FTA Services</h2>
            <p class="text-muted">Manage service contracts and subscriptions</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Service
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Job ID</th>
                                <th>Customer</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th class="text-center">Devices</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var isExpired = item.ServiceEnd < DateTime.Today;
                                var isActive = item.ServiceStatus == "Active";
                                <tr class="@(isExpired ? "table-secondary" : "")">
                                    <td><strong><code>@item.JobID</code></strong></td>
                                    <td>@item.CustomerName</td>
                                    <td>@item.ServiceStart.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @item.ServiceEnd.ToString("MMM dd, yyyy")
                                        @if (isExpired)
                                        {
                                            <span class="badge bg-danger ms-2">Expired</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (item.ServiceStatus)
                                        {
                                            case "Active":
                                                <span class="badge bg-success">@item.ServiceStatus</span>
                                                break;
                                            case "Inactive":
                                                <span class="badge bg-secondary">@item.ServiceStatus</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning">@item.ServiceStatus</span>
                                                break;
                                            case "Expired":
                                                <span class="badge bg-danger">@item.ServiceStatus</span>
                                                break;
                                            default:
                                                <span class="badge bg-info">@item.ServiceStatus</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@item.DeviceCount</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.FTAID" 
                                               class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.FTAID" 
                                               class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.FTAID" 
                                               class="btn btn-sm btn-outline-danger" title="Delete"
                                               onclick="return confirm('Are you sure you want to delete service @item.JobID?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No services found. Click "Add New Service" to get started.</p>
                </div>
            }
        </div>
    </div>
</div>
