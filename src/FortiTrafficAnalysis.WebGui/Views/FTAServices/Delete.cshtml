@model FortiTrafficAnalysis.Domain.Entities.FTAService

@{
    ViewData["Title"] = "Delete Service";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-trash"></i> Delete Service</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Warning!</strong> Are you sure you want to delete this service?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Job ID:</dt>
                        <dd class="col-sm-8"><strong><code>@Model.JobID</code></strong></dd>

                        <dt class="col-sm-4">Customer:</dt>
                        <dd class="col-sm-8">@Model.Customer.CustomerName</dd>

                        <dt class="col-sm-4">Service Period:</dt>
                        <dd class="col-sm-8">@Model.ServiceStart.ToString("MMM dd, yyyy") - @Model.ServiceEnd.ToString("MMM dd, yyyy")</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @switch (Model.ServiceStatus)
                            {
                                case "Active":
                                    <span class="badge bg-success">@Model.ServiceStatus</span>
                                    break;
                                case "Inactive":
                                    <span class="badge bg-secondary">@Model.ServiceStatus</span>
                                    break;
                                default:
                                    <span class="badge bg-info">@Model.ServiceStatus</span>
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-4">Associated Devices:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info">@Model.FortiGates.Count device(s)</span>
                        </dd>
                    </dl>

                    @if (Model.FortiGates.Any())
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-x-circle"></i>
                            This service cannot be deleted because it has <strong>@Model.FortiGates.Count</strong> associated FortiGate device(s).
                            Please delete or reassign the devices first.
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="FTAID" />
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete Service
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
