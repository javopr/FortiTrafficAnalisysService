@model FortiTrafficAnalysis.Domain.Entities.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="bi bi-building"></i> Customer Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Customer Name:</dt>
                        <dd class="col-sm-8"><strong>@Model.CustomerName</strong></dd>

                        <dt class="col-sm-4">Customer ID:</dt>
                        <dd class="col-sm-8"><code>@Model.CustomerID</code></dd>

                        <dt class="col-sm-4">Associated Services:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info">@Model.FTAServices.Count service(s)</span>
                        </dd>
                    </dl>

                    @if (Model.FTAServices.Any())
                    {
                        <hr>
                        <h5>Services</h5>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Job ID</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var service in Model.FTAServices)
                                    {
                                        <tr>
                                            <td><code>@service.JobID</code></td>
                                            <td>@service.ServiceStart.ToString("MMM dd, yyyy")</td>
                                            <td>@service.ServiceEnd.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @switch (service.ServiceStatus)
                                                {
                                                    case "Active":
                                                        <span class="badge bg-success">@service.ServiceStatus</span>
                                                        break;
                                                    case "Inactive":
                                                        <span class="badge bg-secondary">@service.ServiceStatus</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-info">@service.ServiceStatus</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="FTAServices" asp-action="Details" asp-route-id="@service.FTAID" 
                                                   class="btn btn-sm btn-outline-info" title="View Service Details">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.CustomerID" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
